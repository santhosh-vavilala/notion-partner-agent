APP_ENV=development
APP_NAME=notion-partner-agent
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5
NOTION_MCP_URL=https://mcp.notion.com/mcp
# Created by: python scripts/notion_auth.py
NOTION_MCP_TOKEN_FILE=.secrets/notion_mcp_token.json
# Optional production persistence. If empty, in-memory LangGraph checkpoints are used.
DATABASE_URL=
LOG_LEVEL=INFO
MCP_TIMEOUT_SECONDS=45
MAX_MCP_TOOL_CALLS=4
REQUIRE_WRITE_APPROVAL=true
